// GuideMe Database Schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  baby            BabyProfile?
  sentInvites     PartnerLink[] @relation("PrimaryUser")
  receivedInvites PartnerLink[] @relation("PartnerUser")
}

model BabyProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  dob                DateTime
  isPremature        Boolean   @default(false)
  dueDateIfPremature DateTime?
  feedingMethods     String[]
  sensitivities      String[]
  soothingPrefs      String[]
  sensitiveToLight   Boolean   @default(false)
  sensitiveToNoise   Boolean   @default(false)
  routinePreference  String?
  micEnabled         Boolean   @default(false)
  notificationsEnabled Boolean @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  activities ActivityLog[]
  cryEvents  CryEvent[]
}

model ActivityLog {
  id        String      @id @default(cuid())
  babyId    String
  baby      BabyProfile @relation(fields: [babyId], references: [id], onDelete: Cascade)
  type      String      // feeding | sleep | diaper | medicine | growth | cry
  icon      String
  label     String
  detail    String
  notes     String?
  timestamp DateTime    @default(now())
  createdAt DateTime    @default(now())
}

model CryEvent {
  id             String      @id @default(cuid())
  babyId         String
  baby           BabyProfile @relation(fields: [babyId], references: [id], onDelete: Cascade)
  interpretation String      // hunger | fatigue | discomfort | pain
  confidence     Int         // 0-100
  wasCorrect     Boolean?    // null = no feedback yet
  actualNeed     String?     // filled in if wasCorrect = false
  timestamp      DateTime    @default(now())
}

model PartnerLink {
  id            String   @id @default(cuid())
  primaryUserId String
  partnerUserId String?
  inviteEmail   String
  status        String   @default("pending") // pending | active | declined
  createdAt     DateTime @default(now())

  primaryUser User  @relation("PrimaryUser", fields: [primaryUserId], references: [id], onDelete: Cascade)
  partnerUser User? @relation("PartnerUser", fields: [partnerUserId], references: [id])
}
